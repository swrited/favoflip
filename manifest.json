{
    "manifest_version": 3,
    "name": "Web Favorites Clipper",
    "version": "1.0",
    "description": "Collect text and images from web pages to your favorites.",
    "permissions": [
        "contextMenus",
        "storage"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "host_permissions": [
        "https://api.siliconflow.cn/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "View Favorites"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}